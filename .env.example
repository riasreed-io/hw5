# Copy to .env in this folder and fill in your own key. The real .env is
# gitignored and must never be committed.

# Portkey gateway key - every agent in this homework calls gpt-6-luna through it.
PORTKEY_API_KEY=pk-your-portkey-key-here

# Optional: a Portkey virtual key, if your gateway setup uses one.
PORTKEY_VIRTUAL_KEY=

# The only model this assignment permits. Points are deducted for any other.
CAMPUS_CUSTOMS_MODEL=gpt-6-luna
